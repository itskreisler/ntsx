---
import { Terminal, Github, Heart, Shield, Cpu } from 'lucide-astro';
---

<footer class="relative bg-slate-950 border-t border-slate-800 py-16 text-slate-400 font-mono text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">

      <!-- Column 1: Brand -->
      <div class="space-y-4 md:col-span-2">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 p-[1px]">
            <div class="w-full h-full bg-slate-950 rounded-[7px] flex items-center justify-center">
              <Terminal class="w-4 h-4 text-cyan-400" />
            </div>
          </div>
          <span class="text-xl font-bold font-mono text-white">ntsx</span>
        </div>
        <p class="text-slate-400 text-sm font-sans max-w-sm leading-relaxed">
          Ultra-fast native Rust TypeScript script engine with JSDoc dependency resolution, symlink package caching, and Node version pinning.
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="space-y-3">
        <div class="text-white font-bold uppercase tracking-wider text-[11px]">Resources</div>
        <ul class="space-y-2">
          <li><a href="#features" class="hover:text-cyan-400 transition-colors">Features & Architecture</a></li>
          <li><a href="#sandbox" class="hover:text-cyan-400 transition-colors">CLI Sandbox</a></li>
          <li><a href="#calculator" class="hover:text-cyan-400 transition-colors">ROI Calculator</a></li>
          <li><a href="#faq" class="hover:text-cyan-400 transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Column 3: CLI Commands -->
      <div class="space-y-3">
        <div class="text-white font-bold uppercase tracking-wider text-[11px]">CLI Reference</div>
        <ul class="space-y-2 text-slate-400">
          <li><code class="text-cyan-300">ntsx run &lt;script&gt;</code></li>
          <li><code class="text-cyan-300">ntsx lock &lt;script&gt;</code></li>
          <li><code class="text-cyan-300">ntsx tool &lt;tool&gt;</code></li>
          <li><code class="text-cyan-300">ntsx cache stats</code></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Credits -->
    <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500">
      <div>
        © {new Date().getFullYear()} ntsx. MIT Licensed.
      </div>
      <div class="flex items-center gap-2">
        <span>Engineered with Native Rust & TypeScript</span>
      </div>
    </div>

  </div>
</footer>
