---
import { Cpu, Github, Twitter, Linkedin, ArrowUpRight, Shield, Globe } from 'lucide-astro';
---

<footer class="bg-[#020306] border-t border-white/10 pt-16 pb-12 relative z-10 text-slate-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 pb-12 border-b border-white/10">

      <!-- Brand Column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-purple-600 to-cyan-500 p-[1px]">
            <div class="w-full h-full bg-[#0B0F19] rounded-[7px] flex items-center justify-center">
              <Cpu class="w-4 h-4 text-cyan-400" />
            </div>
          </div>
          <span class="font-extrabold text-base text-white tracking-wider">AURA OS</span>
        </div>

        <p class="text-slate-400 text-xs max-w-sm leading-relaxed">
          The next-generation autonomous web & AI orchestration OS platform. Sub-0.4ms latency, zero cold starts, and hardware enclave isolation.
        </p>

        <div class="flex items-center gap-3 text-slate-400">
          <a href="https://github.com/aura-engine" target="_blank" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white transition-colors">
            <Github class="w-4 h-4" />
          </a>
          <a href="https://twitter.com/aura_engine_ai" target="_blank" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white transition-colors">
            <Twitter class="w-4 h-4" />
          </a>
          <a href="https://linkedin.com" target="_blank" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white transition-colors">
            <Linkedin class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Links 1: Platform -->
      <div class="space-y-3">
        <h4 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Platform</h4>
        <ul class="space-y-2">
          <li><a href="#features" class="hover:text-cyan-400 transition-colors">WASM Kernel</a></li>
          <li><a href="#architecture" class="hover:text-cyan-400 transition-colors">Swarm Engine</a></li>
          <li><a href="#playground" class="hover:text-cyan-400 transition-colors">Sandbox Simulator</a></li>
          <li><a href="#pricing" class="hover:text-cyan-400 transition-colors">Scale Pricing</a></li>
        </ul>
      </div>

      <!-- Links 2: Architecture -->
      <div class="space-y-3">
        <h4 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Architecture</h4>
        <ul class="space-y-2">
          <li><a href="#" class="hover:text-cyan-400 transition-colors">Confidential Enclaves</a></li>
          <li><a href="#" class="hover:text-cyan-400 transition-colors">CRDT Mesh Sync</a></li>
          <li><a href="#" class="hover:text-cyan-400 transition-colors">Anycast Edge Nodes</a></li>
          <li><a href="#" class="hover:text-cyan-400 transition-colors">SOC2 Compliance</a></li>
        </ul>
      </div>

      <!-- Links 3: Resources -->
      <div class="space-y-3">
        <h4 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Resources</h4>
        <ul class="space-y-2">
          <li><a href="/sitemap-index.xml" target="_blank" class="hover:text-cyan-400 transition-colors">XML Sitemap</a></li>
          <li><a href="/robots.txt" target="_blank" class="hover:text-cyan-400 transition-colors">Robots.txt</a></li>
          <li><a href="#" class="hover:text-cyan-400 transition-colors">Documentation</a></li>
          <li><a href="#" class="hover:text-cyan-400 transition-colors">Security Specs</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px]">
      <p>© {new Date().getFullYear()} AURA Technologies Inc. All rights reserved.</p>
      <div class="flex items-center gap-2 text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Global Cluster Operational (280 POPs)</span>
      </div>
    </div>
  </div>
</footer>
