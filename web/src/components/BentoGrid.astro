---
import { Cpu, ShieldCheck, Zap, Layers, Sparkles, RefreshCw, Server, Lock, ArrowRight } from 'lucide-astro';
---

<section id="features" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs text-cyan-400 font-mono mb-4">
        <Sparkles class="w-3.5 h-3.5" /> ARCHITECTURAL ADVANTAGE
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Built for <span class="text-gradient-violet">Uncompromising Performance</span>
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        Replace fragile cloud middleware with a unified kernel designed for ultra-low latency, autonomous agent execution, and enterprise security.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div id="bento-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Card 1: Sub-0.4ms Latency (Large 2 Col) -->
      <div class="bento-card md:col-span-2 glass-panel rounded-3xl p-8 border border-white/10 relative overflow-hidden group glass-panel-hover">
        <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-purple-600/20 rounded-full blur-3xl group-hover:bg-purple-600/30 transition-all pointer-events-none"></div>

        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 mb-6 group-hover:scale-110 transition-transform">
              <Zap class="w-6 h-6" />
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Sub-0.4ms Ultra Latency Kernel</h3>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl">
              Custom C++/Rust WebAssembly execution runtime that bypasses heavy OS hypervisors. Cold start times are completely eliminated with instant memory snapshot rehydration.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-white/10 grid grid-cols-3 gap-4 font-mono text-center">
            <div class="bg-white/5 rounded-xl p-3 border border-white/5">
              <span class="text-2xl font-extrabold text-cyan-400">0.38ms</span>
              <p class="text-[10px] text-slate-400 uppercase tracking-wider mt-1">Avg TTFB</p>
            </div>
            <div class="bg-white/5 rounded-xl p-3 border border-white/5">
              <span class="text-2xl font-extrabold text-purple-400">100%</span>
              <p class="text-[10px] text-slate-400 uppercase tracking-wider mt-1">Zero Cold Starts</p>
            </div>
            <div class="bg-white/5 rounded-xl p-3 border border-white/5">
              <span class="text-2xl font-extrabold text-emerald-400">10x</span>
              <p class="text-[10px] text-slate-400 uppercase tracking-wider mt-1">Memory Efficiency</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Autonomous Swarm Agents -->
      <div class="bento-card glass-panel rounded-3xl p-8 border border-white/10 relative overflow-hidden group glass-panel-hover flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition-transform">
            <Cpu class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Autonomous Swarm Engine</h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            Orchestrate multi-agent workflows that automatically communicate, self-correct, and parallelize micro-tasks across global edge clusters.
          </p>
        </div>

        <div class="mt-6 p-4 rounded-xl bg-[#080D1A] border border-cyan-500/20 font-mono text-xs text-cyan-300 flex items-center gap-2">
          <RefreshCw class="w-4 h-4 animate-spin text-cyan-400" />
          <span>Swarm active: 64 sub-agents synced</span>
        </div>
      </div>

      <!-- Card 3: Zero-Trust Security & HSM -->
      <div class="bento-card glass-panel rounded-3xl p-8 border border-white/10 relative overflow-hidden group glass-panel-hover flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
            <Lock class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Hardware-Isolated Enclaves</h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            Every computation runs inside AES-256 encrypted confidential hardware memory bounds (Intel SGX / AMD SEV). Zero data leakage guaranteed.
          </p>
        </div>

        <div class="mt-6 flex items-center justify-between text-xs font-mono text-emerald-400 bg-emerald-500/10 p-3 rounded-xl border border-emerald-500/20">
          <span class="flex items-center gap-1.5"><ShieldCheck class="w-4 h-4" /> End-to-End Encrypted</span>
          <span class="font-bold">SOC2 / ISO</span>
        </div>
      </div>

      <!-- Card 4: Global Mesh Replication (Large 2 Col) -->
      <div class="bento-card md:col-span-2 glass-panel rounded-3xl p-8 border border-white/10 relative overflow-hidden group glass-panel-hover">
        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 mb-6 group-hover:scale-110 transition-transform">
              <Server class="w-6 h-6" />
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Global Instant Mesh Replication</h3>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl">
              Automatic state sync across 280+ POPs worldwide. Your application state and AI KV cache are propagated instantly with Conflict-Free Replicated Data Types (CRDTs).
            </p>
          </div>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-4 p-4 rounded-2xl bg-[#080D1A] border border-white/10">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
              <span class="text-xs font-mono text-slate-300">280 Global Edge Regions Connected</span>
            </div>
            <a href="#playground" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
              Explore Network Mesh <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Mouse Spotlight Script for Bento Grid -->
<script>
  const cards = document.querySelectorAll('.bento-card');

  cards.forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  });
</script>
