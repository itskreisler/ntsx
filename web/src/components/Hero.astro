---
import { Sparkles, ArrowRight, Play, ShieldCheck, Zap, Activity, Globe, Terminal, CheckCircle2 } from 'lucide-astro';
---

<section class="relative pt-12 pb-24 md:pt-20 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Hero Header Content -->
    <div class="text-center max-w-4xl mx-auto flex flex-col items-center">

      <!-- Announcement Pill -->
      <div id="hero-badge" class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-panel border border-purple-500/30 text-xs sm:text-sm text-purple-300 mb-8 shadow-glow-violet hover:border-purple-500/60 transition-all cursor-pointer group">
        <Sparkles class="w-4 h-4 text-amber-400 animate-spin-slow" />
        <span class="font-semibold text-white">Announcing Aura OS 4.0</span>
        <span class="text-slate-400">• Sub-millisecond Neural Compute</span>
        <ArrowRight class="w-3.5 h-3.5 text-purple-400 group-hover:translate-x-1 transition-transform" />
      </div>

      <!-- Hero Title -->
      <h1 id="hero-title" class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
        The Autonomous <br class="hidden sm:inline" />
        <span class="text-gradient-primary">Web & AI OS Platform</span>
      </h1>

      <!-- Hero Description -->
      <p id="hero-desc" class="text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed mb-10 font-normal">
        Deploy, scale, and orchestrate agentic workflows with sub-0.4ms latencies. Engineered with zero-cold-start compute for enterprise high-frequency intelligence.
      </p>

      <!-- CTA Action Buttons -->
      <div id="hero-cta" class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-16">
        <button
          onclick="document.getElementById('contact-modal')?.classList.remove('hidden')"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 hover:from-purple-500 hover:to-cyan-400 text-white font-bold text-base shadow-glow-violet hover:shadow-glow-cyan transition-all duration-300 active:scale-95 flex items-center justify-center gap-2 group"
        >
          <span>Start Free $50k Cloud Credit</span>
          <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
        </button>

        <a
          href="#playground"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl glass-panel hover:bg-white/10 text-slate-200 font-semibold text-base border border-white/10 transition-all flex items-center justify-center gap-2 group"
        >
          <Play class="w-4 h-4 text-cyan-400 fill-cyan-400 group-hover:scale-110 transition-transform" />
          <span>Live Demo Simulator</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div id="hero-trust" class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-mono text-slate-400">
        <div class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-400" /> SOC2 Type II Certified</div>
        <div class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-400" /> 99.999% SLA Guarantee</div>
        <div class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-400" /> Zero Cold Start Compute</div>
      </div>
    </div>

    <!-- Live Telemetry Dashboard Preview (3D Parallax Tilt Card) -->
    <div id="hero-dashboard-wrapper" class="mt-16 relative max-w-5xl mx-auto perspective-1000">
      <div
        id="hero-dashboard"
        class="glass-panel rounded-3xl p-4 sm:p-6 lg:p-8 border border-white/15 shadow-2xl relative overflow-hidden transition-transform duration-200 ease-out"
      >
        <!-- Top Window Header Controls -->
        <div class="flex items-center justify-between pb-6 border-b border-white/10 mb-6">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-rose-500"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
            <span class="ml-4 font-mono text-xs text-slate-400 flex items-center gap-2">
              <Terminal class="w-3.5 h-3.5 text-cyan-400" /> aura-cluster-us-east-1 // live telemetry
            </span>
          </div>

          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded-md bg-cyan-500/10 border border-cyan-500/30 text-[11px] font-mono text-cyan-400 flex items-center gap-1">
              <Activity class="w-3 h-3 animate-pulse" /> 1,248,910 req/s
            </span>
            <span class="px-2.5 py-1 rounded-md bg-purple-500/10 border border-purple-500/30 text-[11px] font-mono text-purple-300">
              Avg Latency: 0.38ms
            </span>
          </div>
        </div>

        <!-- Dashboard Internal Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

          <!-- Column 1: Live Realtime Wave Graph -->
          <div class="lg:col-span-2 glass-panel rounded-2xl p-5 border border-white/5 bg-[#080D1A]/80 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                  <Zap class="w-4 h-4 text-amber-400" /> Neural Compute Pipeline Speed
                </h3>
                <p class="text-xs text-slate-400">Global edge node load balancing</p>
              </div>
              <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">+42.8% vs Legacy Cloud</span>
            </div>

            <!-- Simulated SVG Canvas Chart -->
            <div class="h-44 w-full relative flex items-end">
              <svg class="w-full h-full overflow-visible" viewBox="0 0 500 150">
                <defs>
                  <linearGradient id="chartGlow" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.4" />
                    <stop offset="100%" stop-color="#7C3AED" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path
                  d="M0 120 Q 60 40, 120 90 T 240 30 T 360 80 T 500 20 L 500 150 L 0 150 Z"
                  fill="url(#chartGlow)"
                />
                <path
                  d="M0 120 Q 60 40, 120 90 T 240 30 T 360 80 T 500 20"
                  fill="none"
                  stroke="#06B6D4"
                  stroke-width="3"
                  class="animate-pulse"
                />
              </svg>
            </div>
          </div>

          <!-- Column 2: Live Cluster Metrics & Nodes -->
          <div class="glass-panel rounded-2xl p-5 border border-white/5 bg-[#080D1A]/80 flex flex-col justify-between gap-4">
            <h3 class="text-sm font-semibold text-white flex items-center gap-2">
              <Globe class="w-4 h-4 text-purple-400" /> Active Global Nodes
            </h3>

            <div class="space-y-3 font-mono text-xs">
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/5 border border-white/5">
                <span class="text-slate-300">us-east (N. Virginia)</span>
                <span class="text-emerald-400 font-bold">0.12ms</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/5 border border-white/5">
                <span class="text-slate-300">eu-west (Frankfurt)</span>
                <span class="text-emerald-400 font-bold">0.24ms</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/5 border border-white/5">
                <span class="text-slate-300">ap-northeast (Tokyo)</span>
                <span class="text-emerald-400 font-bold">0.31ms</span>
              </div>
            </div>

            <div class="p-3 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-between">
              <span class="text-xs text-purple-300 font-semibold">Autonomous Failover</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">READY</span>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>
</section>

<!-- GSAP Animations & Mouse Parallax Script -->
<script>
  import { gsap } from 'gsap';

  // GSAP Entrance Timeline
  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  tl.from('#hero-badge', { y: -20, opacity: 0, duration: 0.8 })
    .from('#hero-title', { y: 30, opacity: 0, duration: 1 }, '-=0.5')
    .from('#hero-desc', { y: 20, opacity: 0, duration: 0.8 }, '-=0.6')
    .from('#hero-cta', { y: 20, opacity: 0, duration: 0.8 }, '-=0.6')
    .from('#hero-trust', { opacity: 0, duration: 0.6 }, '-=0.4')
    .from('#hero-dashboard-wrapper', { y: 50, opacity: 0, duration: 1.2, scale: 0.95 }, '-=0.6');

  // Interactive 3D Parallax Tilt Effect on Dashboard
  const card = document.getElementById('hero-dashboard');
  const wrapper = document.getElementById('hero-dashboard-wrapper');

  if (wrapper && card) {
    wrapper.addEventListener('mousemove', (e) => {
      const rect = wrapper.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;

      const tiltX = (y / rect.height) * -12;
      const tiltY = (x / rect.width) * 12;

      card.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.02, 1.02, 1.02)`;
    });

    wrapper.addEventListener('mouseleave', () => {
      card.style.transform = 'rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
    });
  }
</script>
