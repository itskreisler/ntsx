---
import { Terminal, ShieldCheck, Zap, Copy, Check, Cpu, ArrowRight, Play, RefreshCw } from 'lucide-astro';
---

<section class="relative min-h-screen pt-32 pb-20 flex items-center justify-center overflow-hidden">
  <!-- Subtle Grid Pattern Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#0f172a_1px,transparent_1px),linear-gradient(to_bottom,#0f172a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid lg:grid-cols-12 gap-12 items-center">

      <!-- Left Hero Typography -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-6">

        <!-- Badge -->
        <div class="hero-item inline-flex items-center gap-2 px-4 py-2 rounded-full bg-cyan-950/50 border border-cyan-500/30 backdrop-blur-md shadow-[0_0_15px_rgba(6,182,212,0.2)]">
          <span class="flex h-2 w-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span class="text-xs font-mono font-semibold text-cyan-300 uppercase tracking-widest">
            Native Compiled Rust Kernel
          </span>
        </div>

        <!-- Main Title -->
        <h1 class="hero-item text-4xl sm:text-6xl xl:text-7xl font-extrabold text-white tracking-tight leading-[1.08] font-sans">
          Run TypeScript Scripts with <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-indigo-400 drop-shadow-[0_0_35px_rgba(6,182,212,0.4)]">
            Zero Local Setup.
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-item text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed font-light">
          <strong class="text-white font-semibold">ntsx</strong> is a native Rust engine that parses inline JSDoc <code class="px-1.5 py-0.5 rounded bg-slate-800 text-cyan-300 font-mono text-sm">@ntsx</code> annotations, resolves npm packages into an isolated symlink cache, downloads isolated Node binaries on demand, and executes scripts in sub-milliseconds.
        </p>

        <!-- Command Line Box with Copy -->
        <div class="hero-item w-full max-w-lg p-2 rounded-2xl bg-slate-900/90 border border-slate-700/80 backdrop-blur-xl shadow-2xl shadow-cyan-950/50 flex items-center justify-between gap-3 group hover:border-cyan-500/50 transition-all duration-300">
          <div class="flex items-center gap-3 px-3 overflow-hidden font-mono text-sm sm:text-base text-cyan-300">
            <span class="text-slate-500 font-bold select-none">$</span>
            <span id="hero-dynamic-command" class="truncate font-semibold">ntsx run server.ts</span>
          </div>
          <button
            id="copy-hero-cmd"
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 transition-all duration-200 text-xs font-mono font-semibold shrink-0 active:scale-95"
          >
            <Copy class="w-4 h-4" />
            <span id="copy-btn-text">Copy</span>
          </button>
        </div>

        <!-- Metrics Row -->
        <div class="hero-item grid grid-cols-3 gap-6 pt-4 border-t border-slate-800/80 w-full max-w-lg">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white font-mono tracking-tight">0.38ms</div>
            <div class="text-xs text-slate-400 mt-1">Rust Cache Hit</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-cyan-400 font-mono tracking-tight">100%</div>
            <div class="text-xs text-slate-400 mt-1">Node/TS Isolation</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-indigo-400 font-mono tracking-tight">0</div>
            <div class="text-xs text-slate-400 mt-1">node_modules Pollution</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive GSAP Animated Code Terminal -->
      <div class="lg:col-span-5 relative perspective-1000">
        <div
          id="hero-3d-card"
          class="relative w-full rounded-2xl bg-slate-900/90 border border-cyan-500/30 p-5 shadow-[0_0_50px_rgba(6,182,212,0.15)] backdrop-blur-xl transition-transform duration-200 ease-out transform-gpu"
        >
          <!-- Terminal Header & Example Selector Tabs -->
          <div class="flex flex-col space-y-3 pb-3 mb-3 border-b border-slate-800">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
                <span id="hero-tab-filename" class="text-xs font-mono text-slate-300 font-bold ml-2">api-hono.ts</span>
              </div>
              <div class="flex items-center gap-2 px-2.5 py-1 rounded bg-slate-800/80 border border-slate-700/60 text-[11px] font-mono text-cyan-400">
                <Cpu class="w-3 h-3 text-cyan-400" />
                <span>ntsx-rust-v1.2</span>
              </div>
            </div>

            <!-- Example Scenario Switcher -->
            <div class="flex items-center gap-1.5 overflow-x-auto pt-1 text-[11px] font-mono">
              <button data-hero-tab="hono" class="hero-example-tab active px-2.5 py-1 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all">
                JSDoc (@with hono)
              </button>
              <button data-hero-tab="cli" class="hero-example-tab px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 border border-slate-700 hover:text-white transition-all">
                CLI (--with express)
              </button>
              <button data-hero-tab="args" class="hero-example-tab px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 border border-slate-700 hover:text-white transition-all">
                Forwarding (--)
              </button>
            </div>
          </div>

          <!-- Code Display Box with GSAP Animated Content -->
          <div id="hero-code-container" class="font-mono text-xs sm:text-sm text-slate-300 space-y-2 min-h-[220px] p-3 rounded-xl bg-slate-950/80 border border-slate-800/80 leading-relaxed overflow-x-auto">
            <!-- Dynamic example injected by GSAP switcher script -->
          </div>

          <!-- Telemetry & Auto Switch Indicator -->
          <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <div id="hero-telemetry-status" class="flex items-center gap-2 text-emerald-400 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Symlink linked in 0.38ms</span>
            </div>
            <div id="hero-telemetry-node" class="text-slate-500">node v22.12.0 (pinned)</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const heroExamples = {
    hono: {
      filename: 'api-hono.ts',
      command: 'ntsx run api-hono.ts',
      status: 'Symlink linked in 0.38ms',
      node: 'node v22.12.0 (pinned)',
      html: `
        <p class="text-slate-500">/**</p>
        <p class="text-cyan-400 pl-2"> * <span class="text-purple-400 font-bold">@ntsx</span></p>
        <p class="text-cyan-400 pl-2"> * <span class="text-purple-400">@with</span> hono@4.1.0 jose@5.2.0</p>
        <p class="text-cyan-400 pl-2"> * <span class="text-purple-400">@node</span> 22.12.0</p>
        <p class="text-slate-500 pl-2"> */</p>
        <p class="text-purple-300 pt-1">import { <span class="text-white">Hono</span> } from <span class="text-emerald-300">'hono'</span>;</p>
        <p class="text-blue-400">const <span class="text-white">app</span> = <span class="text-purple-300">new</span> <span class="text-amber-300">Hono</span>();</p>
        <p class="text-white">app.<span class="text-amber-300">get</span>(<span class="text-emerald-300">'/api/health'</span>, (c) =&gt; c.<span class="text-amber-300">json</span>(&#123; <span class="text-cyan-300">status</span>: <span class="text-emerald-300">'ok'</span> &#125;));</p>
        <p class="text-emerald-400 font-semibold pt-1">// Native Rust engine installs packages into ~/.cache/ntsx/npm/</p>
      `
    },
    cli: {
      filename: 'express-server.ts',
      command: 'ntsx run --with express@4.18.2 --node 20.18.0 express-server.ts',
      status: 'Node v20.18.0 downloaded & executed',
      node: 'node v20.18.0 (pinned via CLI)',
      html: `
        <p class="text-slate-500">// No JSDoc header required — pass packages via CLI flags!</p>
        <p class="text-purple-300 pt-1">import <span class="text-white">express</span> from <span class="text-emerald-300">'express'</span>;</p>
        <p class="text-blue-400">const <span class="text-white">app</span> = <span class="text-amber-300">express</span>();</p>
        <p class="text-white">app.<span class="text-amber-300">listen</span>(<span class="text-amber-300">3000</span>, () =&gt; {</p>
        <p class="text-white pl-4">console.<span class="text-amber-300">log</span>(<span class="text-emerald-300">'Server listening on port 3000'</span>);</p>
        <p class="text-white">});</p>
      `
    },
    args: {
      filename: 'process-data.ts',
      command: 'ntsx run --with axios script.ts -- --env=production --debug',
      status: 'Arguments forwarded cleanly via --',
      node: 'node v22.12.0',
      html: `
        <p class="text-slate-500">// Arguments after -- are passed straight to process.argv</p>
        <p class="text-purple-300 pt-1">import <span class="text-white">axios</span> from <span class="text-emerald-300">'axios'</span>;</p>
        <p class="text-blue-400">const <span class="text-white">args</span> = process.argv.<span class="text-amber-300">slice</span>(<span class="text-amber-300">2</span>);</p>
        <p class="text-white">console.<span class="text-amber-300">log</span>(<span class="text-emerald-300">'CLI Args:'</span>, args);</p>
        <p class="text-slate-400">// Outputs: ["--env=production", "--debug"]</p>
      `
    }
  };

  const codeContainer = document.getElementById('hero-code-container');
  const filenameEl = document.getElementById('hero-tab-filename');
  const commandEl = document.getElementById('hero-dynamic-command');
  const statusEl = document.getElementById('hero-telemetry-status');
  const nodeEl = document.getElementById('hero-telemetry-node');
  const tabs = document.querySelectorAll('.hero-example-tab');

  function renderHeroExample(key: keyof typeof heroExamples) {
    const data = heroExamples[key];
    if (!codeContainer || !filenameEl || !commandEl || !statusEl || !nodeEl) return;

    gsap.to(codeContainer, {
      opacity: 0,
      y: -10,
      duration: 0.2,
      onComplete: () => {
        codeContainer.innerHTML = data.html;
        filenameEl.textContent = data.filename;
        commandEl.textContent = data.command;
        statusEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span>${data.status}</span>`;
        nodeEl.textContent = data.node;

        gsap.to(codeContainer, {
          opacity: 1,
          y: 0,
          duration: 0.35,
          ease: 'power2.out'
        });
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
        t.classList.add('bg-slate-800', 'text-slate-400', 'border-slate-700');
      });
      tab.classList.add('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
      tab.classList.remove('bg-slate-800', 'text-slate-400', 'border-slate-700');

      const key = (tab.getAttribute('data-hero-tab') || 'hono') as keyof typeof heroExamples;
      renderHeroExample(key);
    });
  });

  // Initial render
  renderHeroExample('hono');

  // GSAP Entrance Animations
  gsap.from('.hero-item', {
    y: 30,
    opacity: 0,
    duration: 0.8,
    stagger: 0.15,
    ease: 'power3.out'
  });

  // Copy command button logic
  const copyBtn = document.getElementById('copy-hero-cmd');
  const copyBtnText = document.getElementById('copy-btn-text');

  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const currentCmd = commandEl?.textContent || 'ntsx run script.ts';
      navigator.clipboard.writeText(currentCmd);
      copyBtnText.textContent = 'Copied!';
      setTimeout(() => {
        copyBtnText.textContent = 'Copy';
      }, 2000);
    });
  }

  // 3D Parallax tilt effect for hero code card
  const card = document.getElementById('hero-3d-card');
  if (card) {
    window.addEventListener('mousemove', (e) => {
      const { innerWidth, innerHeight } = window;
      const x = (e.clientX / innerWidth - 0.5) * 12;
      const y = (e.clientY / innerHeight - 0.5) * -12;
      card.style.transform = `perspective(1000px) rotateX(${y}deg) rotateY(${x}deg)`;
    });
  }
</script>
