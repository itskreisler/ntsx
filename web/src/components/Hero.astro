---
import { Terminal, ShieldCheck, Zap, Copy, Check, Cpu, ArrowRight, Play, RefreshCw, Sparkles } from 'lucide-astro';
---

<section class="relative min-h-screen pt-32 pb-20 flex items-center justify-center overflow-hidden bg-[#07090E]">
  <!-- Grid & Gradient Glow Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#131927_1px,transparent_1px),linear-gradient(to_bottom,#131927_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-tr from-orange-600/10 via-cyan-500/10 to-indigo-600/10 blur-[120px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid lg:grid-cols-12 gap-12 items-center">

      <!-- Left Hero Typography -->
      <div class="lg:col-span-6 flex flex-col items-start space-y-6">

        <!-- Native Rust Badge -->
        <div class="hero-item inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-orange-950/40 border border-orange-500/30 backdrop-blur-md shadow-[0_0_20px_rgba(255,79,0,0.25)]">
          <span class="flex h-2.5 w-2.5 rounded-full bg-orange-500 animate-ping"></span>
          <span class="text-xs font-mono font-bold text-orange-400 uppercase tracking-widest">
            Compiled Rust Kernel • v1.2
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-item text-4xl sm:text-6xl xl:text-7xl font-extrabold text-white tracking-tight leading-[1.08]">
          Run TypeScript Scripts with <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-cyan-400 drop-shadow-[0_0_40px_rgba(255,79,0,0.4)]">
            Zero Local Setup.
          </span>
        </h1>

        <!-- Pitch Description -->
        <p class="hero-item text-base sm:text-lg text-slate-300 max-w-xl leading-relaxed font-light">
          <strong class="text-white font-semibold">ntsx</strong> is a native Rust engine that parses JSDoc <code class="px-1.5 py-0.5 rounded bg-slate-800 text-orange-300 font-mono text-sm">@ntsx</code> metadata, resolves npm packages into an isolated symlink cache (<code class="px-1.5 py-0.5 rounded bg-slate-800 text-cyan-300 font-mono text-sm">~/.cache/ntsx</code>), downloads Node versions on demand, and executes scripts in sub-milliseconds.
        </p>

        <!-- Dynamic Executable CLI Command Box -->
        <div class="hero-item w-full max-w-xl p-2.5 rounded-2xl bg-slate-900/90 border border-orange-500/30 backdrop-blur-xl shadow-2xl shadow-orange-950/30 flex items-center justify-between gap-3 group hover:border-orange-500/60 transition-all duration-300">
          <div class="flex items-center gap-3 px-3 overflow-hidden font-mono text-xs sm:text-sm text-orange-300">
            <span class="text-slate-500 font-bold select-none">$</span>
            <span id="hero-dynamic-command" class="truncate font-semibold text-cyan-300">ntsx run api-hono.ts</span>
          </div>
          <button
            id="copy-hero-cmd"
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-orange-500/10 hover:bg-orange-500/20 text-orange-400 border border-orange-500/30 transition-all duration-200 text-xs font-mono font-bold shrink-0 active:scale-95"
          >
            <Copy class="w-4 h-4" />
            <span id="copy-btn-text">Copy</span>
          </button>
        </div>

        <!-- Metric Benchmarks -->
        <div class="hero-item grid grid-cols-3 gap-6 pt-6 border-t border-slate-800/80 w-full max-w-xl">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-orange-400 font-mono tracking-tight">0.38ms</div>
            <div class="text-xs text-slate-400 mt-1">Rust Cache Hit</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-cyan-400 font-mono tracking-tight">100%</div>
            <div class="text-xs text-slate-400 mt-1">Node/TS Isolation</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-amber-400 font-mono tracking-tight">0</div>
            <div class="text-xs text-slate-400 mt-1">node_modules Pollution</div>
          </div>
        </div>

      </div>

      <!-- Right Column: GSAP Animated Code Terminal Carousel -->
      <div class="lg:col-span-6 relative perspective-1000">
        <div
          id="hero-3d-card"
          class="relative w-full rounded-2xl bg-slate-900/95 border border-orange-500/30 p-5 shadow-[0_0_60px_rgba(255,79,0,0.15)] backdrop-blur-2xl transition-transform duration-200 ease-out transform-gpu"
        >
          <!-- Terminal Window Top Bar & Example Tabs -->
          <div class="flex flex-col space-y-3 pb-3 mb-3 border-b border-slate-800">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
                <span id="hero-tab-filename" class="text-xs font-mono text-slate-200 font-bold ml-2">api-hono.ts</span>
              </div>
              <div class="flex items-center gap-2 px-2.5 py-1 rounded bg-slate-800/90 border border-slate-700/60 text-[11px] font-mono text-orange-400">
                <Cpu class="w-3 h-3 text-orange-400" />
                <span>ntsx-rust-v1.2</span>
              </div>
            </div>

            <!-- Example Scenario Switcher Tabs -->
            <div class="flex items-center gap-1.5 overflow-x-auto pt-1 text-[11px] font-mono scrollbar-none">
              <button data-hero-tab="hono" class="hero-example-tab active px-2.5 py-1 rounded-lg bg-orange-500/20 text-orange-300 border border-orange-500/40 font-semibold transition-all shrink-0">
                JSDoc (@with)
              </button>
              <button data-hero-tab="axios" class="hero-example-tab px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 border border-slate-700 hover:text-white transition-all shrink-0">
                CLI (--with & --node)
              </button>
              <button data-hero-tab="env" class="hero-example-tab px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 border border-slate-700 hover:text-white transition-all shrink-0">
                Inline Env Vars
              </button>
              <button data-hero-tab="args" class="hero-example-tab px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 border border-slate-700 hover:text-white transition-all shrink-0">
                Arg Forwarding (--)
              </button>
              <button data-hero-tab="tool" class="hero-example-tab px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 border border-slate-700 hover:text-white transition-all shrink-0">
                ntsx tool
              </button>
            </div>
          </div>

          <!-- Code Display Box with GSAP Animated Content -->
          <div id="hero-code-container" class="font-mono text-xs sm:text-sm text-slate-300 space-y-2 min-h-[240px] p-4 rounded-xl bg-slate-950/90 border border-slate-800/90 leading-relaxed overflow-x-auto">
            <!-- Dynamic example injected by GSAP switcher script -->
          </div>

          <!-- Telemetry & Auto Switch Indicator -->
          <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <div id="hero-telemetry-status" class="flex items-center gap-2 text-emerald-400 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Symlink linked in 0.38ms</span>
            </div>
            <div id="hero-telemetry-node" class="text-slate-500">node v22.12.0 (pinned)</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const heroExamples = {
    hono: {
      filename: 'api-hono.ts',
      command: 'ntsx run api-hono.ts',
      status: 'Symlink linked in 0.38ms',
      node: 'node v22.12.0 (pinned)',
      html: `
        <p class="text-slate-500">/**</p>
        <p class="text-orange-400 pl-2"> * <span class="text-amber-400 font-bold">@ntsx</span></p>
        <p class="text-orange-400 pl-2"> * <span class="text-amber-400">@with</span> hono@4.1.0 jose@5.2.0</p>
        <p class="text-orange-400 pl-2"> * <span class="text-amber-400">@node</span> 22.12.0</p>
        <p class="text-slate-500 pl-2"> */</p>
        <p class="text-cyan-300 pt-1">import { <span class="text-white">Hono</span> } from <span class="text-emerald-300">'hono'</span>;</p>
        <p class="text-blue-400">const <span class="text-white">app</span> = <span class="text-purple-300">new</span> <span class="text-amber-300">Hono</span>();</p>
        <p class="text-white">app.<span class="text-amber-300">get</span>(<span class="text-emerald-300">'/api/health'</span>, (c) =&gt; c.<span class="text-amber-300">json</span>(&#123; <span class="text-cyan-300">status</span>: <span class="text-emerald-300">'ok'</span> &#125;));</p>
        <p class="text-emerald-400 font-semibold pt-1">// Native Rust engine installs packages into ~/.cache/ntsx/npm/</p>
      `
    },
    axios: {
      filename: 'api-axios.ts',
      command: 'ntsx run --with axios@1.6.0 --node 20.18.0 api-axios.ts',
      status: 'Node v20.18.0 downloaded & cached',
      node: 'node v20.18.0 (pinned via CLI)',
      html: `
        <p class="text-slate-500">// No JSDoc header required — pass packages & node version via CLI!</p>
        <p class="text-cyan-300 pt-1">import <span class="text-white">axios</span> from <span class="text-emerald-300">'axios'</span>;</p>
        <p class="text-blue-400">const <span class="text-white">res</span> = <span class="text-purple-300">await</span> axios.<span class="text-amber-300">get</span>(<span class="text-emerald-300">'https://api.github.com/zen'</span>);</p>
        <p class="text-white">console.<span class="text-amber-300">log</span>(<span class="text-emerald-300">'GitHub Zen:'</span>, res.data);</p>
        <p class="text-emerald-400 font-semibold pt-1">// Node release isolated in ~/.cache/ntsx/node/v20.18.0</p>
      `
    },
    env: {
      filename: 'inline-eval.ts',
      command: 'ntsx run --node-args "--env-file=.env" -e "import { loadEnvFile } from \'node:process\'; loadEnvFile(); console.log(process.env.DB_PASS);"',
      status: 'Inline execution without .env file pollution',
      node: 'node v22.12.0',
      html: `
        <p class="text-slate-500">// Load .env file directly into process.env without modifying local project!</p>
        <p class="text-cyan-300 pt-1">import { <span class="text-white">loadEnvFile</span> } from <span class="text-emerald-300">'node:process'</span>;</p>
        <p class="text-white"><span class="text-amber-300">loadEnvFile</span>();</p>
        <p class="text-white">console.<span class="text-amber-300">log</span>(<span class="text-emerald-300">'Loaded DB Secret:'</span>, process.env.<span class="text-orange-300">DB_PASS</span>);</p>
        <p class="text-emerald-400 font-semibold pt-1">// Zero polluting global dependencies or local node_modules</p>
      `
    },
    args: {
      filename: 'process-data.ts',
      command: 'ntsx run --with axios script.ts -- --to=es --text="Hello World"',
      status: 'Arguments forwarded cleanly via --',
      node: 'node v22.12.0',
      html: `
        <p class="text-slate-500">// Arguments after -- are passed straight to process.argv</p>
        <p class="text-cyan-300 pt-1">import <span class="text-white">axios</span> from <span class="text-emerald-300">'axios'</span>;</p>
        <p class="text-blue-400">const <span class="text-white">args</span> = process.argv.<span class="text-amber-300">slice</span>(<span class="text-amber-300">2</span>);</p>
        <p class="text-white">console.<span class="text-amber-300">log</span>(<span class="text-emerald-300">'Forwarded Args:'</span>, args);</p>
        <p class="text-slate-400">// Outputs: ["--to=es", "--text=Hello World"]</p>
      `
    },
    tool: {
      filename: 'ephemeral-tool.ts',
      command: 'ntsx tool cowsay "ntsx Rust engine is sub-millisecond!"',
      status: 'Executed ephemeral binary directly from npm cache',
      node: 'node v22.12.0',
      html: `
        <p class="text-slate-500">// ntsx tool inspects package.json "bin" field and executes directly</p>
        <p class="text-amber-300 pt-1">$ ntsx tool opencode-ai --version</p>
        <p class="text-white">opencode-ai v1.4.2</p>
        <p class="text-emerald-400 font-semibold pt-1">// No global npm install -g required!</p>
      `
    }
  };

  const codeContainer = document.getElementById('hero-code-container');
  const filenameEl = document.getElementById('hero-tab-filename');
  const commandEl = document.getElementById('hero-dynamic-command');
  const statusEl = document.getElementById('hero-telemetry-status');
  const nodeEl = document.getElementById('hero-telemetry-node');
  const tabs = document.querySelectorAll('.hero-example-tab');

  function renderHeroExample(key: keyof typeof heroExamples) {
    const data = heroExamples[key];
    if (!codeContainer || !filenameEl || !commandEl || !statusEl || !nodeEl) return;

    gsap.to(codeContainer, {
      opacity: 0,
      y: -8,
      duration: 0.18,
      onComplete: () => {
        codeContainer.innerHTML = data.html;
        filenameEl.textContent = data.filename;
        commandEl.textContent = data.command;
        statusEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span>${data.status}</span>`;
        nodeEl.textContent = data.node;

        gsap.to(codeContainer, {
          opacity: 1,
          y: 0,
          duration: 0.3,
          ease: 'power2.out'
        });
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('active', 'bg-orange-500/20', 'text-orange-300', 'border-orange-500/40');
        t.classList.add('bg-slate-800', 'text-slate-400', 'border-slate-700');
      });
      tab.classList.add('active', 'bg-orange-500/20', 'text-orange-300', 'border-orange-500/40');
      tab.classList.remove('bg-slate-800', 'text-slate-400', 'border-slate-700');

      const key = (tab.getAttribute('data-hero-tab') || 'hono') as keyof typeof heroExamples;
      renderHeroExample(key);
    });
  });

  // Initial render
  renderHeroExample('hono');

  // GSAP Entrance Animations
  gsap.from('.hero-item', {
    y: 25,
    opacity: 0,
    duration: 0.7,
    stagger: 0.12,
    ease: 'power3.out'
  });

  // Copy command button logic
  const copyBtn = document.getElementById('copy-hero-cmd');
  const copyBtnText = document.getElementById('copy-btn-text');

  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const currentCmd = commandEl?.textContent || 'ntsx run script.ts';
      navigator.clipboard.writeText(currentCmd);
      copyBtnText.textContent = 'Copied!';
      setTimeout(() => {
        copyBtnText.textContent = 'Copy';
      }, 2000);
    });
  }

  // 3D Parallax tilt effect for hero code card
  const card = document.getElementById('hero-3d-card');
  if (card) {
    window.addEventListener('mousemove', (e) => {
      const { innerWidth, innerHeight } = window;
      const x = (e.clientX / innerWidth - 0.5) * 10;
      const y = (e.clientY / innerHeight - 0.5) * -10;
      card.style.transform = `perspective(1000px) rotateX(${y}deg) rotateY(${x}deg)`;
    });
  }
</script>
