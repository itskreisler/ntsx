---
import { Star, Quote, ShieldCheck, ArrowUpRight } from 'lucide-astro';

const testimonials = [
  {
    quote: "Migrating our core AI inference pipeline to Aura OS reduced our p99 latency from 140ms down to 0.38ms while cutting AWS infrastructure costs by 62%.",
    author: "Dr. Elena Vance",
    role: "VP of Autonomous Engineering",
    company: "Nexus AI Labs",
    metrics: "62% Cost Reduction",
    rating: 5,
  },
  {
    quote: "The confidential hardware enclaves gave our compliance team 100% peace of mind for financial transactions across European banks.",
    author: "Marcus Vance",
    role: "Chief Security Officer",
    company: "FinFlow Global",
    metrics: "SOC2 & ISO Compliant",
    rating: 5,
  },
  {
    quote: "Aura's swarm orchestration allowed us to deploy 500 micro-agents simultaneously. What used to take hours of devops tuning now takes 2 seconds.",
    author: "Siddharth Patel",
    role: "Principal Infrastructure Architect",
    company: "HyperScale Tech",
    metrics: "500x Faster Deployments",
    rating: 5,
  },
];
---

<section class="py-24 relative overflow-hidden bg-[#04060A]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-400 font-mono mb-4">
        <ShieldCheck class="w-3.5 h-3.5" /> VERIFIED ENTERPRISE RESULTS
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Trusted By <span class="text-gradient-violet">World-Class Engineering Teams</span>
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        See how industry leaders scale their mission-critical Web & AI infrastructure on Aura OS.
      </p>
    </div>

    <!-- Testimonial Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="glass-panel rounded-3xl p-8 border border-white/10 flex flex-col justify-between glass-panel-hover group relative">
          <Quote class="w-10 h-10 text-purple-500/20 absolute top-6 right-6 group-hover:text-purple-500/40 transition-colors" />

          <div>
            <div class="flex items-center gap-1 text-amber-400 mb-6">
              {[...Array(t.rating)].map(() => (
                <Star class="w-4 h-4 fill-amber-400 text-amber-400" />
              ))}
            </div>

            <p class="text-slate-300 text-sm leading-relaxed mb-8 italic">
              "{t.quote}"
            </p>
          </div>

          <div class="pt-6 border-t border-white/10 flex items-center justify-between">
            <div>
              <h4 class="text-sm font-bold text-white">{t.author}</h4>
              <p class="text-xs text-slate-400">{t.role} • <span class="text-cyan-400 font-medium">{t.company}</span></p>
            </div>

            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-[10px] font-mono font-bold text-emerald-400">
              {t.metrics}
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
