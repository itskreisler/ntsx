---
import { Play, Terminal, CheckCircle2, RefreshCw, Cpu } from 'lucide-astro';
---

<section id="sandbox" class="py-24 relative overflow-hidden bg-slate-950/80 border-y border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono text-xs uppercase tracking-widest font-semibold">
        Interactive CLI Playground
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Simulate <span class="text-cyan-400">ntsx</span> Execution Live
      </h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Select an example script to observe JSDoc dependency resolution, symlink creation, and execution logs in real time.
      </p>
    </div>

    <!-- Playground Window -->
    <div class="max-w-4xl mx-auto rounded-2xl bg-slate-900 border border-slate-700/80 shadow-2xl overflow-hidden backdrop-blur-2xl">

      <!-- Top Toolbar -->
      <div class="flex flex-wrap items-center justify-between p-4 bg-slate-950 border-b border-slate-800 gap-3">

        <!-- Preset Buttons -->
        <div class="flex items-center gap-2">
          <button
            data-preset="github"
            class="sandbox-preset-btn active px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all bg-cyan-500/20 text-cyan-300 border border-cyan-500/40"
          >
            octokit + chalk
          </button>
          <button
            data-preset="aws"
            class="sandbox-preset-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-all border border-transparent"
          >
            @aws-sdk/s3
          </button>
          <button
            data-preset="tool"
            class="sandbox-preset-btn px-3 py-1.5 rounded-lg text-xs font-mono font-semibold text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-all border border-transparent"
          >
            ntsx tool
          </button>
        </div>

        <!-- Run Trigger -->
        <button
          id="run-sandbox-btn"
          class="flex items-center gap-2 px-5 py-2 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-mono text-xs font-bold shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/40 hover:scale-105 transition-all duration-200 active:scale-95"
        >
          <Play class="w-3.5 h-3.5 fill-current" />
          <span>Execute Script</span>
        </button>
      </div>

      <!-- Editor & Output Grid -->
      <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-800 font-mono text-xs">

        <!-- Code Window -->
        <div class="p-5 bg-slate-900/90 text-slate-300 space-y-2 overflow-x-auto min-h-[320px]">
          <div class="text-slate-500 pb-2 border-b border-slate-800 flex items-center justify-between">
            <span>INPUT: script.ts</span>
            <span class="text-[10px] text-cyan-400">JSDoc Parsed</span>
          </div>
          <pre id="sandbox-code-view" class="text-slate-300 leading-relaxed font-mono">/**
 * @ntsx
 * @with octokit@3.1.0 chalk@5.3.0
 * @node 22.12.0
 */
import chalk from 'chalk';
import &#123; Octokit &#125; from 'octokit';

const octokit = new Octokit();
console.log(chalk.cyan('Fetching repo metadata...'));
const &#123; data &#125; = await octokit.rest.repos.get(&#123;
  owner: 'kreisler',
  repo: 'ntsx'
&#125;);
console.log(`Repo Stars: $&#123;data.stargazers_count&#125;`);</pre>
        </div>

        <!-- Console Stream Output -->
        <div class="p-5 bg-slate-950 text-slate-300 flex flex-col justify-between min-h-[320px]">
          <div>
            <div class="text-slate-500 pb-2 border-b border-slate-800 flex items-center justify-between">
              <span>OUTPUT STREAM</span>
              <span id="sandbox-status" class="text-[10px] text-emerald-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Idle
              </span>
            </div>

            <div id="sandbox-logs" class="pt-3 space-y-2 text-[11px] leading-relaxed">
              <div class="text-slate-500">$ ntsx run script.ts</div>
              <div class="text-slate-600">Click "Execute Script" to run simulation...</div>
            </div>
          </div>

          <!-- Sandbox Footer Stats -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-[10px] text-slate-500">
            <span>Execution Kernel: Rust v1.2</span>
            <span id="sandbox-time" class="text-cyan-400">0.00ms</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const presets: Record<string, { code: string; logs: string[]; executionTime: string }> = {
    github: {
      code: `/**\n * @ntsx\n * @with octokit@3.1.0 chalk@5.3.0\n * @node 22.12.0\n */\nimport chalk from 'chalk';\nimport { Octokit } from 'octokit';\n\nconst octokit = new Octokit();\nconsole.log(chalk.cyan('Fetching repo metadata...'));\nconst { data } = await octokit.rest.repos.get({\n  owner: 'kreisler',\n  repo: 'ntsx'\n});\nconsole.log(\`Repo Stars: \${data.stargazers_count}\`);`,
      logs: [
        '[ntsx] Parsing JSDoc annotations from script.ts...',
        '[ntsx] Cache lookup: octokit@3.1.0, chalk@5.3.0 -> MATCH (hash: 8f92a1)',
        '[ntsx] Linking ~/.cache/ntsx/npm/8f92a1 -> ./node_modules',
        'Fetching repo metadata...',
        'Repo Stars: 1,420',
        '✔ Execution finished successfully.'
      ],
      executionTime: '0.41ms'
    },
    aws: {
      code: `/**\n * @ntsx\n * @with @aws-sdk/client-s3@3.500.0\n * @node 20.18.0\n */\nimport { S3Client, ListBucketsCommand } from '@aws-sdk/client-s3';\n\nconst client = new S3Client({ region: 'us-east-1' });\nconst command = new ListBucketsCommand({});\nconsole.log('Listing AWS S3 Buckets...');`,
      logs: [
        '[ntsx] Parsing JSDoc annotations from script.ts...',
        '[ntsx] Pinning Node.js version 20.18.0 (cached: ~/.cache/ntsx/node/v20.18.0)',
        '[ntsx] Symlink dependency tree prepared.',
        'Listing AWS S3 Buckets...',
        'Found 4 buckets in us-east-1.',
        '✔ Execution finished successfully.'
      ],
      executionTime: '0.38ms'
    },
    tool: {
      code: `// ntsx tool executes ephemeral binaries directly\n$ ntsx tool opencode-ai --version\n\n// ntsx tool inspects package bin fields automatically\n$ ntsx tool cowsay "ntsx makes CLI scripting instant!"`,
      logs: [
        '[ntsx tool] Inspecting package.json "bin" field for cowsay...',
        '[ntsx tool] Executing binary target: cowsay',
        ' ________________________________________',
        '< ntsx makes CLI scripting instant! >',
        ' ----------------------------------------',
        '        \\   ^__^',
        '         \\  (oo)\\_______',
        '            (__)\\       )/\\',
        '                ||----w |',
        '                ||     ||',
        '✔ Ephemeral tool executed without npm install.'
      ],
      executionTime: '0.29ms'
    }
  };

  const codeView = document.getElementById('sandbox-code-view');
  const logsView = document.getElementById('sandbox-logs');
  const statusView = document.getElementById('sandbox-status');
  const timeView = document.getElementById('sandbox-time');
  const runBtn = document.getElementById('run-sandbox-btn');
  const presetBtns = document.querySelectorAll('.sandbox-preset-btn');

  let activePreset = 'github';

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      presetBtns.forEach(b => {
        b.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
        b.classList.add('text-slate-400', 'border-transparent');
      });
      btn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
      btn.classList.remove('text-slate-400', 'border-transparent');

      const presetKey = btn.getAttribute('data-preset') || 'github';
      activePreset = presetKey;
      if (codeView) {
        codeView.textContent = presets[presetKey].code;
      }
      if (logsView) {
        logsView.innerHTML = `
          <div class="text-slate-500">$ ntsx run script.ts</div>
          <div class="text-slate-600">Click "Execute Script" to run simulation...</div>
        `;
      }
      if (timeView) timeView.textContent = '0.00ms';
    });
  });

  if (runBtn) {
    runBtn.addEventListener('click', () => {
      if (!logsView || !statusView || !timeView) return;

      statusView.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span> Executing...`;
      logsView.innerHTML = `<div class="text-slate-500">$ ntsx run script.ts</div>`;

      const data = presets[activePreset];
      let delay = 150;

      data.logs.forEach((log, idx) => {
        setTimeout(() => {
          const line = document.createElement('div');
          if (log.startsWith('[ntsx]')) {
            line.className = 'text-cyan-400 font-semibold';
          } else if (log.startsWith('✔')) {
            line.className = 'text-emerald-400 font-bold';
          } else {
            line.className = 'text-slate-300';
          }
          line.textContent = log;
          logsView.appendChild(line);

          if (idx === data.logs.length - 1) {
            statusView.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Success`;
            timeView.textContent = data.executionTime;
          }
        }, delay * (idx + 1));
      });
    });
  }
</script>
