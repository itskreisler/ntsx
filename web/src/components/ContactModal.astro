---
import { X, Terminal, Check, Copy, ArrowRight, Shield } from 'lucide-astro';
---

<div
  id="contact-modal-overlay"
  class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4 transition-opacity duration-300 opacity-0"
>
  <div
    id="contact-modal-card"
    class="relative w-full max-w-lg rounded-3xl bg-slate-900 border border-cyan-500/30 p-8 shadow-2xl transition-all duration-300 transform scale-95"
  >
    <!-- Close Button -->
    <button
      id="close-modal-btn"
      class="absolute top-6 right-6 p-2 rounded-xl bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-colors"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Modal Content -->
    <div class="space-y-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono text-xs uppercase tracking-wider font-semibold">
          Quick Start Guide
        </div>
        <h3 class="text-2xl font-bold text-white tracking-tight">
          Install Native <span class="text-cyan-400">ntsx</span> Rust Binary
        </h3>
        <p class="text-slate-400 text-sm">
          Download pre-compiled standalone Rust binaries for Linux and Windows, or build directly from source using Cargo.
        </p>
      </div>

      <!-- Command Block -->
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
        <div class="text-slate-500">// 1. Build & install native Rust binary</div>
        <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800">
          <code class="text-cyan-300">$ cargo install --path rust</code>
          <button
            id="modal-copy-btn-1"
            class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white transition-colors text-[10px]"
          >
            Copy
          </button>
        </div>

        <div class="text-slate-500 pt-2">// 2. Execute any script immediately</div>
        <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800">
          <code class="text-cyan-300">$ ntsx run my-script.ts</code>
          <button
            id="modal-copy-btn-2"
            class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white transition-colors text-[10px]"
          >
            Copy
          </button>
        </div>
      </div>

      <!-- Feature Checklist -->
      <div class="space-y-2 pt-2 text-xs font-mono text-slate-300">
        <div class="flex items-center gap-2">
          <Check class="w-4 h-4 text-emerald-400" />
          <span>Zero local node_modules pollution</span>
        </div>
        <div class="flex items-center gap-2">
          <Check class="w-4 h-4 text-emerald-400" />
          <span>Automatic JSDoc dependency resolution</span>
        </div>
        <div class="flex items-center gap-2">
          <Check class="w-4 h-4 text-emerald-400" />
          <span>Compiled for Linux & Windows (x86_64 / arm64)</span>
        </div>
      </div>

      <button
        id="modal-done-btn"
        class="w-full py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-mono text-xs font-bold shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/40 transition-all"
      >
        Dismiss
      </button>
    </div>

  </div>
</div>

<script>
  const modalOverlay = document.getElementById('contact-modal-overlay');
  const modalCard = document.getElementById('contact-modal-card');
  const openBtn = document.getElementById('open-modal-btn');
  const closeBtn = document.getElementById('close-modal-btn');
  const doneBtn = document.getElementById('modal-done-btn');

  function openModal() {
    if (modalOverlay && modalCard) {
      modalOverlay.classList.remove('hidden');
      modalOverlay.classList.add('flex');
      setTimeout(() => {
        modalOverlay.classList.remove('opacity-0');
        modalOverlay.classList.add('opacity-100');
        modalCard.classList.remove('scale-95');
        modalCard.classList.add('scale-100');
      }, 10);
    }
  }

  function closeModal() {
    if (modalOverlay && modalCard) {
      modalOverlay.classList.remove('opacity-100');
      modalOverlay.classList.add('opacity-0');
      modalCard.classList.remove('scale-100');
      modalCard.classList.add('scale-95');
      setTimeout(() => {
        modalOverlay.classList.remove('flex');
        modalOverlay.classList.add('hidden');
      }, 300);
    }
  }

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (doneBtn) doneBtn.addEventListener('click', closeModal);

  // Copy helper
  const copy1 = document.getElementById('modal-copy-btn-1');
  const copy2 = document.getElementById('modal-copy-btn-2');

  if (copy1) {
    copy1.addEventListener('click', () => {
      navigator.clipboard.writeText('cargo install --path rust');
      copy1.textContent = 'Copied!';
      setTimeout(() => copy1.textContent = 'Copy', 2000);
    });
  }

  if (copy2) {
    copy2.addEventListener('click', () => {
      navigator.clipboard.writeText('ntsx run my-script.ts');
      copy2.textContent = 'Copied!';
      setTimeout(() => copy2.textContent = 'Copy', 2000);
    });
  }
</script>
