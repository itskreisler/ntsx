---
import { X, Send, Sparkles, CheckCircle2, Building, Cpu, ShieldAlert, ArrowRight } from 'lucide-astro';
---

<div id="contact-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-md transition-opacity">

  <div class="glass-panel max-w-xl w-full rounded-3xl border border-white/20 p-6 sm:p-8 shadow-2xl relative bg-[#080D1A] overflow-hidden">

    <!-- Close Button -->
    <button
      onclick="document.getElementById('contact-modal')?.classList.add('hidden')"
      class="absolute top-6 right-6 p-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-colors"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Modal Content Header -->
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-xs text-purple-300 font-mono mb-3">
        <Sparkles class="w-3.5 h-3.5 text-amber-400" /> INSTANT ENTERPRISE ONBOARDING
      </div>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white">Deploy Aura OS Engine</h3>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Get immediate access to $50,000 in dedicated cloud credits and private cluster provisioning.</p>
    </div>

    <!-- Form Body -->
    <form id="contact-form" class="space-y-4">

      <!-- Scope Selection Pill Badges -->
      <div>
        <label class="block text-xs font-mono uppercase text-slate-300 mb-2 font-semibold">Primary Workload Objective</label>
        <div class="grid grid-cols-2 gap-2" id="scope-selector">
          <button type="button" class="scope-btn p-3 rounded-xl border border-purple-500/50 bg-purple-600/20 text-white text-xs font-semibold text-left transition-all active-scope">
            ⚡ Autonomous Swarm Agents
          </button>
          <button type="button" class="scope-btn p-3 rounded-xl border border-white/10 bg-white/5 text-slate-300 text-xs font-semibold text-left transition-all hover:bg-white/10">
            🎨 High-Speed Web Infrastructure
          </button>
          <button type="button" class="scope-btn p-3 rounded-xl border border-white/10 bg-white/5 text-slate-300 text-xs font-semibold text-left transition-all hover:bg-white/10">
            🛡️ Confidential Hardware Enclave
          </button>
          <button type="button" class="scope-btn p-3 rounded-xl border border-white/10 bg-white/5 text-slate-300 text-xs font-semibold text-left transition-all hover:bg-white/10">
            🚀 Custom Enterprise Cluster
          </button>
        </div>
      </div>

      <!-- Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-mono text-slate-400 mb-1">Full Name</label>
          <input
            type="text"
            required
            placeholder="Sarah Connor"
            class="w-full bg-[#04060A] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400 transition-colors"
          />
        </div>

        <div>
          <label class="block text-xs font-mono text-slate-400 mb-1">Work Email</label>
          <input
            type="email"
            required
            placeholder="sarah@enterprise.com"
            class="w-full bg-[#04060A] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400 transition-colors"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">Estimated Monthly API Volume</label>
        <select class="w-full bg-[#04060A] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400 transition-colors">
          <option>10M - 50M requests / month</option>
          <option>50M - 250M requests / month</option>
          <option>250M+ requests / month (Custom Dedicated Cluster)</option>
        </select>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submit-contact-btn"
        class="w-full py-4 rounded-xl bg-gradient-to-r from-purple-600 via-cyan-500 to-indigo-600 hover:from-purple-500 hover:to-cyan-400 text-white font-bold text-sm shadow-glow-violet transition-all flex items-center justify-center gap-2 group mt-2"
      >
        <Send class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        <span>Request $50,000 Credit & Access</span>
      </button>

      <!-- Simulated Success Message -->
      <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono text-xs text-center flex items-center justify-center gap-2">
        <CheckCircle2 class="w-5 h-5 text-emerald-400" />
        <span>Access key provisioned! Check your email for login credentials.</span>
      </div>

    </form>

  </div>
</div>

<script>
  const scopeBtns = document.querySelectorAll('.scope-btn');
  const contactForm = document.getElementById('contact-form');
  const formSuccess = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-contact-btn');

  scopeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      scopeBtns.forEach(b => {
        b.className = 'scope-btn p-3 rounded-xl border border-white/10 bg-white/5 text-slate-300 text-xs font-semibold text-left transition-all hover:bg-white/10';
      });
      btn.className = 'scope-btn p-3 rounded-xl border border-purple-500/50 bg-purple-600/20 text-white text-xs font-semibold text-left transition-all active-scope';
    });
  });

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (submitBtn) submitBtn.innerHTML = '<span>Provisioning Enclave...</span>';

    setTimeout(() => {
      if (submitBtn) submitBtn.classList.add('hidden');
      if (formSuccess) formSuccess.classList.remove('hidden');

      setTimeout(() => {
        document.getElementById('contact-modal')?.classList.add('hidden');
        if (submitBtn) submitBtn.classList.remove('hidden');
        if (formSuccess) formSuccess.classList.add('hidden');
      }, 2500);
    }, 800);
  });
</script>
