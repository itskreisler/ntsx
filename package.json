{
  "name": "ntx",
  "version": "0.1.0",
  "description": "Run Node/TS scripts with ephemeral dependencies (uv-style --with) via npm cache + symlink",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ntx": "dist/ntx.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts -- --help",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
