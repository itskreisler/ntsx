{
  "name": "@kreisler/ntsx",
  "version": "0.1.7",
  "description": "Run Node/TS scripts with ephemeral dependencies (uv-style --with) via npm cache + symlink",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cli",
    "run",
    "typescript",
    "tsx",
    "node",
    "npx",
    "ephemeral",
    "dependencies",
    "uv",
    "script-runner"
  ],
  "bin": {
    "ntsx": "dist/ntsx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts -- --help",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
